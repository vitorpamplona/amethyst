    },
    {
      "id": "nip17-counterparty",
      "name": "NIP-17 DMs vs another client",
      "counterpart": "(to be named)",
      "enabled": false,
      "reason": "harness not landed yet: add tools/interop-ci/suites/nip17-counterparty.sh (rename the id to the counterpart) and enable",
      "channels": ["pinned", "latest"],
      "isolation": "netns",
      "addresses": ["192.0.2.2/32"],
      "toolchains": [],
      "timeout": 30,
      "cache": [],
      "logs": [],
      "parties": {"amy": "amy"},
      "default_direction": null,
      "rules": []
    }
  ]
}
