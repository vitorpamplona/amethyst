{
  "_doc": [
    "Registry of the interop suites the nightly workflow runs (.github/workflows/interop-nightly.yml).",
    "One entry per suite. To add a suite: write tools/interop-ci/suites/<id>.sh (resolve / prepare / run,",
    "see tools/interop-ci/run-suite.sh), add an entry here, and nothing in the workflow changes.",
    "Fields:",
    "  id            matrix key and the name of the driver script and results file",
    "  name          shown in the job name and the report",
    "  counterpart   the other implementation, as shown in the matrix columns",
    "  enabled       false keeps the suite out of CI; the report lists it with `reason`",
    "  channels      'pinned' (blocking) and/or 'latest' (non-blocking early warning)",
    "  isolation     'netns': the run happens in a network namespace with only loopback (and the",
    "                addresses in `addresses`), so it cannot reach any other host. 'loopback': the",
    "                run needs Docker-published ports, so it runs on the host with AMY_LOCAL_ONLY=1",
    "                and every relay on 127.0.0.1",
    "  addresses     extra addresses for the namespace's lo (a non-private one lets amy resolve",
    "                another account's relay list to the local relay)",
    "  toolchains    which setup steps the job runs: node, rust, docker, protoc, psql",
    "  timeout       minutes for the run step",
    "  cache         paths the job caches, keyed by suite, channel and the resolved counterpart commit",
    "  logs          paths uploaded with the results",
    "  parties       aliases a result id uses for each side, for reading a direction out of the id",
    "  default_direction  direction when neither a rule nor the id names one",
    "  rules         [regex on the result id, feature, direction or null], first match wins",
    "Directions are 'amy→cp' (amy produced, the counterpart consumed), 'cp→amy', 'both', or 'amy'."
  ],
  "suites": [
    {
      "id": "marmot",
      "name": "Marmot / MLS",
      "counterpart": "MDK wn/wnd",
      "enabled": true,
      "channels": ["pinned", "latest"],
      "isolation": "netns",
      "addresses": [],
      "toolchains": ["rust", "protoc"],
      "timeout": 90,
      "cache": ["~/.cache/amethyst-interop/marmot/bin"],
      "logs": ["cli/tests/marmot/state-headless/logs", "cli/tests/marmot/state-headless/B/logs", "cli/tests/marmot/state-headless/C/logs", "cli/tests/marmot/state-headless/relay/logs"],
      "parties": {"A": "amy", "amy": "amy", "D": "amy", "B": "cp", "C": "cp", "wn": "cp", "wn_c": "cp", "W": "cp", "W2": "cp"},
      "default_direction": null,
      "rules": [
        ["^01 ", "KeyPackages (MIP-00)", "both"],
        ["^13 ", "KeyPackages (MIP-00)", "amy→cp"],
        ["^16 ", "KeyPackages (MIP-00)", "cp→amy"],
        ["^(02|04) ", "Create + invite (MIP-02)", "amy→cp"],
        ["^(03|05) ", "Create + invite (MIP-02)", "cp→amy"],
        ["^(06|34) ", "Member removal", "amy→cp"],
        ["^14 ", "Member removal", "cp→amy"],
        ["^(11|29) ", "Leave / disband", "amy→cp"],
        ["^(15|33) ", "Leave / disband", "cp→amy"],
        ["^07 ", "Group metadata (MIP-01)", "both"],
        ["^(17|20) ", "Group metadata (MIP-01)", "amy→cp"],
        ["^21 ", "Group metadata (MIP-01)", "cp→amy"],
        ["^08 ", "Admins", "cp→amy"],
        ["^(09|31) ", "Replies, reactions, threads", "amy→cp"],
        ["^38 ", "Replies, reactions, threads", "cp→amy"],
        ["^(10|30) ", "Commits + convergence", "both"],
        ["^32 ", "Commits + convergence", "amy→cp"],
        ["^12 ", "Offline catch-up", "cp→amy"],
        ["^(22|23|36) ", "Edits + deletions", "amy→cp"],
        ["^(27|37) ", "Edits + deletions", "cp→amy"],
        ["^24 ", "Encrypted media", "amy→cp"],
        ["^(25|35) ", "Encrypted media", "cp→amy"],
        ["^(26|28) ", "Disappearing messages", "amy→cp"],
        ["^(40|41|45|48) ", "Device groups", "cp→amy"],
        ["^(42|43|44|46|49) ", "Device groups", "amy→cp"],
        ["^47 ", "Device groups", "both"],
        ["^50 ", "Device groups", "amy"],
        ["^harness", "Harness", null]
      ]
    },
    {
      "id": "concord",
      "name": "Concord",
      "counterpart": "Armada",
      "enabled": true,
      "channels": ["pinned", "latest"],
      "isolation": "netns",
      "addresses": ["192.0.2.2/32"],
      "toolchains": ["node"],
      "timeout": 45,
      "cache": ["~/.cache/amethyst-interop/concord/armada/node_modules"],
      "logs": ["build/interop-ci/state/concord"],
      "parties": {"amy": "amy", "armada": "cp"},
      "default_direction": null,
      "rules": [
        ["^a[0-9]", "Invites + joins (Armada's community)", null],
        ["^b[0-9]", "Messages, edits, reactions", null],
        ["^c[0-9]", "Invites + joins (amy's community)", null],
        ["^d[0-9]", "Roles + grants", null],
        ["^e[0-9]", "Moderation + Refounding", null],
        ["^f[0-9]", "Private channels, pins, timers, dissolve", null],
        ["^harness", "Harness", null]
      ]
    },
    {
      "id": "buzz",
      "name": "Buzz relay (NIP-29 + Buzz)",
      "counterpart": "buzz-relay",
      "enabled": true,
      "channels": ["pinned", "latest"],
      "isolation": "loopback",
      "addresses": [],
      "toolchains": ["rust", "docker", "psql"],
      "timeout": 60,
      "cache": ["~/.cache/amethyst-interop/buzz/bin"],
      "logs": ["cli/tests/buzz/state-buzz-relay-interop/logs"],
      "parties": {"amy": "amy"},
      "default_direction": "amy→cp",
      "rules": [
        ["^harness", "Harness", null]
      ]
    },
    {
      "id": "dm",
      "name": "NIP-17 DMs",
      "counterpart": "amy",
      "enabled": true,
      "channels": ["pinned"],
      "isolation": "netns",
      "addresses": ["192.0.2.2/32"],
      "toolchains": [],
      "timeout": 20,
      "cache": [],
      "logs": ["cli/tests/dm/state-dm-headless/logs", "cli/tests/dm/state-dm-headless/relay/logs"],
      "parties": {},
      "default_direction": "amy",
      "rules": [
        ["^dm-0[1256]", "NIP-17 inbox routing (kind 10050)", null],
        ["^dm-03", "NIP-17 strict inbox refusal", null],
        ["^dm-04", "NIP-65 fallback", null],
        ["^harness", "Harness", null]
      ]
    },
    {
      "id": "relaygroup",
      "name": "NIP-29 relay groups",
      "counterpart": "geode",
      "enabled": true,
      "channels": ["pinned"],
      "isolation": "netns",
      "addresses": [],
      "toolchains": [],
      "timeout": 15,
      "cache": [],
      "logs": ["cli/tests/relaygroup/state-relaygroup-headless/logs"],
      "parties": {},
      "default_direction": "amy→cp",
      "rules": [
        ["^create", "Create a group (9007 + 9002)", null],
        ["^message", "Group chat (kind 9)", null],
        ["^(join|list)", "Join (9021) + group list (10009)", null],
        ["^browse", "Browse groups (39000)", null],
        ["^harness", "Harness", null]
      ]
    },
    {
      "id": "cordn",
      "name": "cordn",
      "counterpart": "cordn coordinator + @cordn/cli",
      "enabled": false,
      "reason": "the reference coordinator (packages/coordinator, ghcr.io/cordn-msg/cordn) has no LICENSE; cordn-kmp's plan §7 rules out wiring it into CI until upstream licenses it. Run cli/tests/cordn/*.sh by hand.",
      "channels": [],
      "isolation": "loopback",
      "toolchains": [],
      "timeout": 0,
      "cache": [],
      "logs": [],
      "parties": {},
      "default_direction": null,
      "rules": []
    },
    {
      "id": "nip29-counterparty",
      "name": "NIP-29 vs another relay/client",
      "counterpart": "(to be named)",
      "enabled": false,
      "reason": "harness not landed yet: add tools/interop-ci/suites/nip29-counterparty.sh (rename the id to the counterpart) and enable",
      "channels": ["pinned", "latest"],
      "isolation": "netns",
      "toolchains": [],
      "timeout": 30,
      "cache": [],
