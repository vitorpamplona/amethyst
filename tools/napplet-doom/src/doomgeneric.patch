     // wipe update
     wipe_EndScreen(0, 0, SCREENWIDTH, SCREENHEIGHT);
 
-    wipestart = I_GetTime () - 1;
+    // The melt used to spin here until it finished, which a browser main thread cannot do:
+    // D_WipeStep() advances it once per call until it is done.
+    wipe_start_time = I_GetTime () - 1;
+    wipe_in_progress = true;
+    D_WipeStep ();
+}
 
-    do
-    {
-	do
-	{
-	    nowtime = I_GetTime ();
-	    tics = nowtime - wipestart;
-            I_Sleep(1);
-	} while (tics <= 0);
-        
