-	I_FinishUpdate ();                      // page flip or blit buffer
-    } while (!done);
+boolean D_WipeInProgress (void)
+{
+    return wipe_in_progress;
+}
+
+void D_WipeStep (void)
+{
+    int nowtime = I_GetTime ();
+    int tics = nowtime - wipe_start_time;
+
+    if (tics <= 0)
+        return;
+
+    wipe_start_time = nowtime;
+    if (wipe_ScreenWipe(wipe_Melt, 0, 0, SCREENWIDTH, SCREENHEIGHT, tics))
+        wipe_in_progress = false;
+    I_UpdateNoBlit ();
+    M_Drawer ();                            // menu is drawn even on top of wipes
+    I_FinishUpdate ();                      // page flip or blit buffer
 }
 
