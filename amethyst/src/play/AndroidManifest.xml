<?xml version="1.0" encoding="utf-8"?>
<!--
  The Google Play channel: everything `complete` ships except the Health Connect integration.
  Google Play keeps rejecting the submission over the health permissions, so this manifest strips
  every trace of them from the merged result.

  The <application> declarations below are the Google-services ones and are IDENTICAL to
  src/complete/AndroidManifest.xml — AGP allows a source set exactly one manifest, so the two
  channels cannot share a file. Change one, change the other.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <!--
      Health Connect removals. The declarations themselves live in src/main/AndroidManifest.xml,
      shared by `complete` and `fdroid`; this channel subtracts them so the store listing asks for
      no health permission and exposes no health entry point. The androidx.health library, which
      would contribute declarations of its own, is not on this channel's classpath at all (see
      amethyst/build.gradle.kts).
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" tools:node="remove" />
        <intent tools:node="remove">
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.health.READ_EXERCISE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" tools:node="remove" />

    <application
        android:name=".Amethyst">

        <!-- The Health Connect rationale screen and its Android 14+ VIEW_PERMISSION_USAGE alias.
             Both are declared in src/main and are meaningless without the health permissions. -->
        <activity
            android:name=".ui.screen.loggedIn.workouts.health.HealthConnectRationaleActivity"
            tools:node="remove" />
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            tools:node="remove" />

        <service
            android:name=".service.notifications.PushNotificationReceiverService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <!--Remove Firebase Logging-->
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove">
        </service>

        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false"/>

        <meta-data android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/amethyst" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/purple_500" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/app_notification_channel_id" />

        <!-- Google Cast SDK options provider. Only declared in the play
             flavor because the SDK hard-depends on Google Play services. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.vitorpamplona.amethyst.service.cast.chromecast.AmethystCastOptionsProvider" />

        <!-- Gemini / system-agent bridge via androidx.appfunctions
             (pre-stable as of May 2026). The androidx-provided
             PlatformAppFunctionService (registered automatically via
             manifest merging by the library) dispatches to plain Kotlin
             classes annotated with @AppFunction (see
             com.vitorpamplona.amethyst.appfunctions.AmethystAppFunctions).
             Play flavor only — the F-Droid channel ships without the
             alpha Google AI dependency.

             The `app_metadata` property below gives the system agent a
             user-facing summary of what this app exposes. Without it,
             system logcat logs "Unable to resolve AppFunctionMetadata"
             and our functions never make it into Gemini's tool picker. -->
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

    </application>

</manifest>