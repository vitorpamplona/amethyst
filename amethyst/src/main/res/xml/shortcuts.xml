<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher shortcuts (long-press the app icon).

    "Scan QR code" exists because scanning was three taps deep - profile, then the QR screen, then
    a Scan button - which is a long way to reach the thing you do while standing in front of
    someone. The intent carries no targetPackage on purpose: debug and benchmark builds append an
    applicationId suffix, so a hardcoded one would resolve to nothing. `nostr:scanqr` is matched by
    MainActivity's existing nostr-scheme VIEW filter and turned into a route by uriToRoute.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="scan_qr"
        android:enabled="true"
        android:icon="@drawable/ic_qrcode"
        android:shortcutShortLabel="@string/shortcut_scan_qr_short"
        android:shortcutLongLabel="@string/shortcut_scan_qr_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nostr:scanqr" />
    </shortcut>
</shortcuts>
